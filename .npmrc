# Registry configuration (decision T22). The `@trellis` scope — today only `@trellis/contracts`,
# the OpenAPI + GraphQL client that the trellis-backend pipeline publishes — comes from that
# project's GitLab Package Registry, not from npmjs.com.
#
# Every value here is an environment variable; a token is never written into this file.
#   TRELLIS_CONTRACTS_REGISTRY_HOST  gitlab host, e.g. gitlab.com
#   TRELLIS_CONTRACTS_PROJECT_ID     numeric project id of trellis-backend
#   TRELLIS_CONTRACTS_TOKEN          CI: $CI_JOB_TOKEN (set in .gitlab-ci.yml, scoped to the pipeline)
#                                    local: a personal access token with `read_api`, exported from your
#                                    shell profile or a git-ignored .npmrc.local
#
# npm leaves an unset ${VAR} as a literal value. These settings are needed when @trellis/contracts
# is installed (see scripts/check-contracts.mjs).
@trellis:registry=https://${TRELLIS_CONTRACTS_REGISTRY_HOST}/api/v4/projects/${TRELLIS_CONTRACTS_PROJECT_ID}/packages/npm/
//${TRELLIS_CONTRACTS_REGISTRY_HOST}/api/v4/projects/${TRELLIS_CONTRACTS_PROJECT_ID}/packages/npm/:_authToken=${TRELLIS_CONTRACTS_TOKEN}

# Dependency install scripts are denied unless package.json explicitly approves them.
strict-allow-scripts=true

# Keep these pinned Playwright releases installable when a release-age window is configured.
min-release-age-exclude[]=@playwright/test@1.65.1
min-release-age-exclude[]=playwright-core@1.65.1
min-release-age-exclude[]=playwright@1.65.1
